# ============ LLM 配置 ============
# 模型提供商：openai / deepseek / qwen / glm / ollama / custom
LLM_PROVIDER=deepseek
# API 密钥
LLM_API_KEY=sk-your-key-here
# API 地址（留空用默认；custom 时必填；Ollama 本地部署时填 http://host.docker.internal:11434）
LLM_API_BASE=
# 模型名称（如 gpt-4o-mini / deepseek-chat / qwen-plus / glm-4-flash / llama3.1）
LLM_MODEL=deepseek-chat

# Embedding 模型（可选，留空则使用 ChromaDB 内置本地模型，零配置）
# 例如：text-embedding-3-small（OpenAI）/ text-embedding-v3（通义）/ embedding-3（智谱）/ nomic-embed-text（Ollama）
EMBEDDING_MODEL=

# ============ 管理后台 ============
# 首次启动前务必修改为强密码！
ADMIN_PASSWORD=change_this_before_running

# ============ 数据库 ============
# 默认 SQLite 零配置；如需 PostgreSQL：postgresql+asyncpg://user:pass@host:5432/leadchat
DATABASE_URL=sqlite+aiosqlite:///./data/db/leadchat.db

# ============ 网络 ============
# 允许跨域的来源，逗号分隔；* 表示全部允许
CORS_ORIGINS=*

# ============ 品牌页脚 ============
# 页面底部「Powered by 栈上月明 | 陕ICP备2026016303号-1」，设为 false 关闭，默认开启
BRANDING_FOOTER_ENABLED=true

# ============ 对话 ============
# 对话闲置超过该分钟数后自动标记为「已结束」；0 表示不自动结束
CONVERSATION_TIMEOUT_MINUTES=30
