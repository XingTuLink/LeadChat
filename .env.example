# LeadChat 环境变量（全部可选）
# 本文件不做任何修改、甚至不存在，都可以直接运行：
# - 数据库默认 SQLite，数据在 ./data 下
# - Embedding 使用内置本地模型（已打入镜像，离线可用）
# - 对话模型请在启动后登录管理后台「模型管理」中添加
#
# 需要覆盖默认值时，取消对应行的注释即可。

# 管理后台密码（不设置时默认 admin123；正式部署建议修改）
# ADMIN_PASSWORD=your-strong-password

# 数据库（默认 SQLite；切换 PostgreSQL 时填写）
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/leadchat

# 跨域来源（默认 * 全部允许，多个来源用逗号分隔）
# CORS_ORIGINS=*

# 品牌页脚（默认开启；设为 false 关闭）
# BRANDING_FOOTER_ENABLED=true

# 对话闲置自动结束分钟数（默认 30；0 表示不自动结束）
# CONVERSATION_TIMEOUT_MINUTES=30
