# ============ 对话模型 ============
# 对话模型不再通过本文件配置：启动后登录管理后台，在「模型管理」中添加模型并激活，
# 支持配置多个模型、运行时在线切换。未激活任何模型时对话功能不可用。

# ============ Embedding（可选） ============
# 留空则使用 ChromaDB 内置本地模型，零配置
# 例如：openai/text-embedding-3-small / qwen/text-embedding-v3 / glm/embedding-3 / ollama/nomic-embed-text
EMBEDDING_MODEL=
# 仅当使用远程 Embedding 模型时需要（本地模型留空）
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=

# ============ 管理后台 ============
# 首次启动前务必修改为强密码！
ADMIN_PASSWORD=change_this_before_running

# ============ 数据库 ============
# 默认 SQLite 零配置；如需 PostgreSQL：postgresql+asyncpg://user:pass@host:5432/leadchat
DATABASE_URL=sqlite+aiosqlite:///./data/db/leadchat.db

# ============ 网络 ============
# 允许跨域的来源，逗号分隔；* 表示全部允许
CORS_ORIGINS=*

# ============ 品牌页脚 ============
# 页面底部「Powered by 栈上月明 | 陕ICP备2026016303号-1」，设为 false 关闭，默认开启
BRANDING_FOOTER_ENABLED=true

# ============ 对话 ============
# 对话闲置超过该分钟数后自动标记为「已结束」；0 表示不自动结束
CONVERSATION_TIMEOUT_MINUTES=30
